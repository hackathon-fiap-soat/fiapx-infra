# Copie para .env só se quiser trocar algum valor. Sem .env, o compose usa estes mesmos padrões.
# São credenciais de uso exclusivamente local: nunca use estes valores na AWS.

MYSQL_ROOT_PASSWORD=root_local
FIAPX_AUTH_DB_PASSWORD=fiapx_auth_local
FIAPX_VIDEO_DB_PASSWORD=fiapx_video_local

# Portas expostas na máquina
MYSQL_PORT=3306
LOCALSTACK_PORT=4566
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Origem do front-end (CORS do bucket e links dos e-mails)
FIAPX_WEB_URL=http://localhost:5173

# Host do MySQL gravado nos segredos fiapx/local/db/*
FIAPX_DB_HOST=localhost
